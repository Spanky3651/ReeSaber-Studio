{
  "id": "./",
  "name": "ReeSaber Studio",
  "short_name": "ReeSaber Studio",
  "description": "Build and edit ReeSabers presets for Beat Saber with a live 3D preview, then export a ready-to-use config.",
  "start_url": "./?utm_source=pwa&utm_campaign=installed",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["games", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./?utm_source=pwa&utm_campaign=open-file",
      "accept": {
        "application/x-reesaber": [".reesaber"],
        "application/json": [".json"]
      },
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ]
}
